generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  MINI_JOB
}

enum EmployeeRole {
  WAITER
  RUNNER
  BARTENDER
}

enum AvailabilityStatus {
  SUBMITTED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  systemRole   SystemRole @map("system_role")
  employeeId   String?    @unique @map("employee_id") @db.Uuid
  employee     Employee?  @relation(fields: [employeeId], references: [id])
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("users")
}

model Employee {
  id              String         @id @default(uuid()) @db.Uuid
  firstName       String         @map("first_name")
  lastName        String         @map("last_name")
  email           String         @unique
  phone           String?
  employmentType  EmploymentType @map("employment_type")
  employeeRole    EmployeeRole   @map("employee_role")
  weeklyHourLimit Int            @map("weekly_hour_limit")
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  user            User?
  availabilities  Availability[]

  @@map("employees")
}

model Availability {
  id            String             @id @default(uuid()) @db.Uuid
  employeeId    String             @map("employee_id") @db.Uuid
  employee      Employee           @relation(fields: [employeeId], references: [id])
  weekStartDate DateTime           @map("week_start_date") @db.Date
  status        AvailabilityStatus
  entries       AvailabilityEntry[]
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@unique([employeeId, weekStartDate])
  @@map("availabilities")
}

model AvailabilityEntry {
  id             String       @id @default(uuid()) @db.Uuid
  availabilityId String       @map("availability_id") @db.Uuid
  availability   Availability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)
  date           DateTime     @db.Date
  startTime      String       @map("start_time")
  endTime        String       @map("end_time")
  available      Boolean
  preferred      Boolean

  @@map("availability_entries")
}

model Shift {
  id            String       @id @default(uuid()) @db.Uuid
  date          DateTime     @db.Date
  startTime     String       @map("start_time")
  endTime       String       @map("end_time")
  employeeRole  EmployeeRole @map("employee_role")
  requiredCount Int          @map("required_count")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("shifts")
}
